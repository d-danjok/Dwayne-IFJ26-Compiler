    {
      "id": "vVtlxhU_Ek-7z8aKw8yoO",
      "type": "text",
      "x": -356.5512142002143,
      "y": -703.0169796571083,
      "width": 1651.8612624717243,
      "height": 175,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1031083952,
      "version": 443,
      "versionNonce": 206790559,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1795721759901,
      "link": null,
      "locked": false,
      "text": "1. NL checks in this order: EOL owed  ->  ' '  '\\t'  '\\r'  EOL  '/'  ->  EOF  ->  any other char (peeked, not consumed, compared with top).\n2. Only spaces count as indentation. A '\\t' before the first token of a line is INVALID_INDENTATION.\n3. Inside ( ) (Pdepth > 0) no EOL / INDENT / DEDENT is returned; a continuation line must be indented deeper than top.\n4. '  /* c */ x' : the spaces after the comment are skipped, so x keeps the indentation counted before the comment.\n5. After a block comment that spans lines, only spaces, tabs and comments may follow until EOL (WAITING EOL).\n6. EOF is seen only in the call that reads it: after TOKEN DEDENT the next call goes DEDENT -> START -> NL -> DEDENT again.\n7. After every returned token: NL = type not in {EOL, EOF, INDENT, DEDENT}; state = START unless it is NL or DEDENT.",
      "originalText": "1. NL checks in this order: EOL owed  ->  ' '  '\\t'  '\\r'  EOL  '/'  ->  EOF  ->  any other char (peeked, not consumed, compared with top).\n2. Only spaces count as indentation. A '\\t' before the first token of a line is INVALID_INDENTATION.\n3. Inside ( ) (Pdepth > 0) no EOL / INDENT / DEDENT is returned; a continuation line must be indented deeper than top.\n4. '  /* c */ x' : the spaces after the comment are skipped, so x keeps the indentation counted before the comment.\n5. After a block comment that spans lines, only spaces, tabs and comments may follow until EOL (WAITING EOL).\n6. EOF is seen only in the call that reads it: after TOKEN DEDENT the next call goes DEDENT -> START -> NL -> DEDENT again.\n7. After every returned token: NL = type not in {EOL, EOF, INDENT, DEDENT}; state = START unless it is NL or DEDENT.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": false,
      "lineHeight": 1.25,
      "index": "c030G",
      "created": 1795692928868,
      "labelPosition": null,
      "baseFontSize": null
    },
